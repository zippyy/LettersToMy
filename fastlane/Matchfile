# fastlane Match — Code Signing
#
# Stores certificates and provisioning profiles in a private git repo
# so every developer and CI runner uses the same signing assets.
#
# First-time setup (run once locally):
#   1. Create a private git repo for match (e.g. github.com/your-org/certs)
#   2. bundle exec fastlane match init
#   3. Set git_url below to point to that repo
#   4. bundle exec fastlane match appstore
#   5. bundle exec fastlane match development
#
# After initial setup, CI uses readonly: true to pull existing certs.

git_url(ENV["MATCH_GIT_URL"] || "git@github.com:zippyy/letters-to-my-certs.git")

storage_mode("git")

type("appstore")

# App identifiers for LettersToMy
app_identifier([
  "com.bayoumountainholdings.LettersToMy",
  "com.bayoumountainholdings.LettersToMy.mac"
])

# Required for macOS signing
platform("ios")   # match defaults; override per-lane for macOS

# Uncomment to force new certs:
# force(true)
# force_for_new_devices(true)

# Set passphrase; must match MATCH_PASSWORD env var in CI.
# ENV["MATCH_PASSWORD"] is read automatically by fastlane.
