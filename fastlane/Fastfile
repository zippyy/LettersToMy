# LettersToMy Fastlane Configuration
#
# See docs/APP_STORE_SETUP.md for the full App Store Connect and
# CloudKit setup guide. The lanes below assume:
#
#   - fastlane match stores signing assets in a private git repo
#   - App Store Connect API key is configured via environment:
#       ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY (base64 .p8 contents)
#   - MATCH_PASSWORD is set in CI secrets
#   - MATCH_GIT_URL points to the match repo
#
# Required GitHub Actions secrets (set in repo Settings → Secrets):
#   ASC_KEY_ID           – App Store Connect API Key ID
#   ASC_ISSUER_ID        – App Store Connect Issuer ID
#   ASC_KEY              – Base64-encoded .p8 private key
#   MATCH_PASSWORD       – Passphrase for the match repo
#   MATCH_GIT_URL        – Git URL for the match certificate repo
#   MATCH_GIT_BASIC_AUTHORIZATION – (optional) token for private match repo

default_platform(:ios)

platform :ios do
  before_all do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "180"
    setup_ci if ENV["CI"]
  end

  # ── load the App Store Connect API key from CI secrets ──────────
  lane :load_asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY"],
      in_house: false
    )
  end

  # ── iOS: build + upload to TestFlight ───────────────────────────
  desc "Build iOS app and upload to TestFlight"
  lane :ios_testflight do
    load_asc_api_key

    match(
      type: "appstore",
      app_identifier: "com.bayoumountainholdings.LettersToMy",
      readonly: true
    )

    # Generate the Xcode project from XcodeGen.
    sh("xcodegen", "generate")

    # Increment build number to match GitHub Actions run number.
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "LettersToMy.xcodeproj"
    )

    build_app(
      scheme: "LettersToMy",
      workspace: nil,
      project: "LettersToMy.xcodeproj",
      export_method: "app-store",
      clean: true,
      output_directory: "build/ios",
      output_name: "LettersToMy.ipa",
      include_symbols: true,
      include_bitcode: false
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,   # set to true for external groups
      changelog: ENV["CHANGELOG"] || git_log_short,
      notify_external_testers: false
    )
  end

  # ── macOS: build + upload to TestFlight ─────────────────────────
  desc "Build macOS app and upload to TestFlight"
  lane :mac_testflight do
    load_asc_api_key

    match(
      type: "appstore",
      app_identifier: "com.bayoumountainholdings.LettersToMy.mac",
      readonly: true,
      platform: "macos"
    )

    sh("xcodegen", "generate")

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "LettersToMy.xcodeproj"
    )

    build_mac_app(
      scheme: "LettersToMyMac",
      project: "LettersToMy.xcodeproj",
      export_method: "app-store",
      clean: true,
      output_directory: "build/macos",
      output_name: "LettersToMy.pkg"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["CHANGELOG"] || git_log_short,
      notify_external_testers: false,
      platform: "osx"
    )
  end

  # ── combined lane ───────────────────────────────────────────────
  desc "Build iOS + macOS and upload both to TestFlight"
  lane :all_testflight do
    ios_testflight
    mac_testflight
  end

  # ── helpers ─────────────────────────────────────────────────────
  def git_log_short
    `git log -1 --pretty=format:"%s%n%n%b"`.strip
  rescue
    "Automated build from CI."
  end
end